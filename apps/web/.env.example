# 数据库连接地址；默认使用本地 SQLite 文件
DATABASE_URL="file:./data/yilink.db"

# Auth.js 会话加密密钥；生产环境必须替换为高强度随机值
AUTH_SECRET="请替换为至少 32 字节的随机密钥"

# 内部日汇总端点的 Bearer 密钥；Cloudflare Worker 与 GitHub Actions 必须配置为同一高强度随机值
CRON_SECRET="请替换为高强度随机密钥"

# 可选：邀请码白名单，多个邀请码用英文逗号分隔；留空时保持开放注册
INVITE_CODES=""

# Auth.js 对外访问地址；本地开发默认使用 3000 端口
AUTH_URL="http://localhost:3000"

# 可选：GitHub OAuth App 的 Client ID；留空时不启用 GitHub 登录
GITHUB_ID=""

# 可选：GitHub OAuth App 的 Client Secret；留空时不启用 GitHub 登录
GITHUB_SECRET=""

# 可选：公开主页承载域名；留空时启用单域模式
PAGES_HOST=""

# 可选：未设置 PAGES_HOST 时，二维码生成使用的公开应用地址
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 可选：营销页 GitHub 链接；留空时使用官方仓库
NEXT_PUBLIC_GITHUB_URL="https://github.com/zhangfeite/yilink"

# 可选：营销页与公开页举报邮箱；留空时使用 report@yilink.app
REPORT_EMAIL="report@yilink.app"

# LemonSqueezy Webhook 的 HMAC-SHA256 签名密钥；未配置时回调接口会拒绝处理
LEMONSQUEEZY_WEBHOOK_SECRET=""

# LemonSqueezy「基础买断」商品变体 ID，用于将付款订单映射为 PRO_MINI
LEMONSQUEEZY_VARIANT_MINI=""

# LemonSqueezy「完整买断」商品变体 ID，用于将付款订单映射为 PRO
LEMONSQUEEZY_VARIANT_PRO=""

# LemonSqueezy「基础买断」结账链接；留空时营销页显示「即将开放」
LEMONSQUEEZY_CHECKOUT_URL_MINI=""

# LemonSqueezy「完整买断」结账链接；留空时营销页显示「即将开放」
LEMONSQUEEZY_CHECKOUT_URL_PRO=""

# 浏览器端展示的「基础买断」价格文案；默认值为 $12
NEXT_PUBLIC_PRICE_MINI="$12"

# 浏览器端展示的「完整买断」价格文案；默认值为 $25
NEXT_PUBLIC_PRICE_PRO="$25"

# 微信 JS-SDK 分享卡片（可选）：配置公众号 AppID/AppSecret 后，微信内打开的主页
# 转发到会话/朋友圈时展示自定义标题、摘要与缩略图。需在公众号后台把主页域名
# 加入「JS 接口安全域名」。不配置则该功能休眠，页面零额外开销。
# WECHAT_JSSDK_APP_ID=
# WECHAT_JSSDK_APP_SECRET=
