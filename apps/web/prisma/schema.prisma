generator client {
  provider        = "prisma-client-js"
  // Cloudflare Workers：官方路径——默认输出位置 + driverAdapters，
  // OpenNext 构建期会 patch 该 client 适配 workerd（勿自定义 output）
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

