{
  "name": "@yilink/web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "db:generate": "XDG_CACHE_HOME=${XDG_CACHE_HOME:-../../.cache} DATABASE_URL=${DATABASE_URL:-file:./data/yilink.db} prisma generate",
    "db:migrate": "XDG_CACHE_HOME=${XDG_CACHE_HOME:-../../.cache} DATABASE_URL=${DATABASE_URL:-file:./data/yilink.db} prisma migrate dev",
    "db:deploy": "XDG_CACHE_HOME=${XDG_CACHE_HOME:-../../.cache} DATABASE_URL=${DATABASE_URL:-file:./data/yilink.db} prisma migrate deploy",
    "db:seed": "XDG_CACHE_HOME=${XDG_CACHE_HOME:-../../.cache} DATABASE_URL=${DATABASE_URL:-file:./data/yilink.db} node prisma/seed.mjs",
    "admin:grant": "node scripts/grant-admin.mjs",
    "stats:rollup": "DATABASE_URL=${DATABASE_URL:-file:./data/yilink.db} node scripts/rollup-daily.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "6.19.2",
    "@yilink/icons": "workspace:*",
    "@yilink/moderation": "workspace:*",
    "@yilink/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.13.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/qrcode": "^1.5.6",
    "prisma": "6.19.2",
    "tailwindcss": "4.3.3"
  }
}
