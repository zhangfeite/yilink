# Docker Compose 使用的 SQLite 数据库文件；位于 named volume 中
DATABASE_URL="file:/data/yilink.db"

# Auth.js 会话加密密钥；部署前请替换为至少 32 字节的随机值
AUTH_SECRET="replace-with-a-random-secret-before-production"

# 应用对外访问地址；部署到域名后请改为完整 HTTPS 地址
AUTH_URL="http://localhost:3000"

# 可选：GitHub OAuth App 的 Client ID；与 Secret 同时设置时启用 GitHub 登录
GITHUB_ID=""

# 可选：GitHub OAuth App 的 Client Secret
GITHUB_SECRET=""

# 可选：公开主页独立承载域名；留空时使用主域名下的 /p/slug
PAGES_HOST=""

# 可选：未设置 PAGES_HOST 时，二维码生成使用的公开应用地址
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 可选：LemonSqueezy Webhook 的 HMAC-SHA256 签名密钥
LEMONSQUEEZY_WEBHOOK_SECRET=""

# 可选：LemonSqueezy「基础买断」商品变体 ID
LEMONSQUEEZY_VARIANT_MINI=""

# 可选：LemonSqueezy「完整买断」商品变体 ID
LEMONSQUEEZY_VARIANT_PRO=""

# 可选：LemonSqueezy「基础买断」结账链接；两个套餐链接都有效时显示升级入口
LEMONSQUEEZY_CHECKOUT_URL_MINI=""

# 可选：LemonSqueezy「完整买断」结账链接
LEMONSQUEEZY_CHECKOUT_URL_PRO=""

# 可选：浏览器端展示的「基础买断」价格文案
NEXT_PUBLIC_PRICE_MINI="$12"

# 可选：浏览器端展示的「完整买断」价格文案
NEXT_PUBLIC_PRICE_PRO="$25"
